# Build output (mdBook's default build-dir is ./book)
/book/

# Node modules
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated highlight.js bundle (built by `make highlight`)
theme/highlight.js
theme/highlight.js.map

# Scratch files written by the book's own examples when they are run. Several
# examples demonstrate io:write and the like, so running them from the
# repository root leaves these behind.
/output/
/output.txt
/report.txt

# Editor directories and files
.vscode/
.idea/
*.sublime-*
*.swp
*.swo
.DS_Store

# Temporary files
*.tmp
*.temp
.cache/
